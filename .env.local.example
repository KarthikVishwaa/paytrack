# Local dev DB (run `npm run db` in a second terminal), or paste your MongoDB Atlas URI here.
MONGODB_URI="mongodb://127.0.0.1:27017/paytrack"

# Any long random string. Change this before you deploy.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional. If you run Redis, the app caches the dashboard in it so pages open instantly.
# Leave it blank and the app uses an in-memory cache instead — nothing to install.
# REDIS_URL="redis://127.0.0.1:6379"
